<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PocketCake.Views.PresetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PocketCake.Views"
    xmlns:vm="using:PocketCake.ViewModels">

    <UserControl.Resources>
        <!-- Effect parameters: one card per parameter. -->
        <DataTemplate x:Key="SliderParameterTemplate" x:DataType="vm:ParameterItem">
            <Border Padding="16,10" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ValueText, Mode=OneWay}" />
                    <Slider
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                        IsThumbToolTipEnabled="False"
                        Maximum="{x:Bind Maximum}"
                        Minimum="{x:Bind Minimum}"
                        SmallChange="{x:Bind Step}"
                        StepFrequency="{x:Bind Step}"
                        Value="{x:Bind Value, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToggleParameterTemplate" x:DataType="vm:ParameterItem">
            <Border Padding="16,10" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                        IsOn="{x:Bind IsOn, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceParameterTemplate" x:DataType="vm:ParameterItem">
            <Border Padding="16,10" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                        ItemsSource="{x:Bind Options}"
                        SelectedIndex="{x:Bind Index, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:ParameterTemplateSelector
            x:Key="ParameterTemplateSelector"
            Choice="{StaticResource ChoiceParameterTemplate}"
            Slider="{StaticResource SliderParameterTemplate}"
            Toggle="{StaticResource ToggleParameterTemplate}" />

        <!-- Signal chain: a tile per module; the DRV-AMP-IR-EQ block is grouped. -->
        <DataTemplate x:Key="ModuleTileTemplate" x:DataType="vm:ModuleTile">
            <Grid
                Width="88"
                Height="132"
                Margin="1"
                Background="Transparent"
                Tapped="{x:Bind Select}">
                <Border Padding="10,10,4,4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Left"
                            Background="{x:Bind local:ModuleVisuals.Tint(Name)}"
                            CornerRadius="15"
                            Opacity="{x:Bind local:ModuleVisuals.Dim(IsOn), Mode=OneWay}">
                            <FontIcon
                                FontSize="15"
                                Foreground="{x:Bind local:ModuleVisuals.Brush(Name)}"
                                Glyph="{x:Bind local:ModuleVisuals.Glyph(Name)}" />
                        </Border>
                        <Border
                            Margin="0,0,6,0"
                            Padding="5,0,5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind HasFootswitch, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Footswitch, Mode=OneWay}" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind EffectName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Row="2"
                            MinWidth="0"
                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                            IsOn="{x:Bind IsOn, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </Border>
                <Border
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChainGroupTemplate" x:DataType="vm:ChainGroup">
            <StackPanel Orientation="Horizontal">
                <FontIcon
                    Margin="2,0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;"
                    Visibility="{x:Bind ShowConnector, Mode=OneWay}" />
                <Grid>
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{x:Bind IsAmpBlock}" />
                    <ItemsControl
                        Margin="4"
                        ItemTemplate="{StaticResource ModuleTileTemplate}"
                        ItemsSource="{x:Bind Modules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Preset list -->
        <Grid
            Padding="12,12,8,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="BankBar" SelectionChanged="OnBankChanged">
                <SelectorBarItem x:Name="UserBankItem" Text="User">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="FactoryBankItem" Text="Factory">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <AutoSuggestBox
                Grid.Row="1"
                PlaceholderText="Search presets"
                QueryIcon="Find"
                TextChanged="OnSearchChanged" />
            <ListView
                x:Name="PresetList"
                Grid.Row="2"
                IsEnabled="{x:Bind ViewModel.CanPickPreset, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="OnPresetClick"
                ItemsSource="{x:Bind ViewModel.Presets}"
                SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetItem">
                        <StackPanel Padding="0,7" Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="38"
                                Padding="0,1,0,2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Label}" />
                            </Border>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Placeholder: not connected / nothing loaded -->
        <StackPanel
            Grid.Column="1"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowPlaceholder, Mode=OneWay}">
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" />
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8D6;" />
            </Grid>
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.PlaceholderTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.PlaceholderMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="OnConnectClick"
                Content="Connect…"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.ShowConnectButton, Mode=OneWay}" />
        </StackPanel>

        <!-- Editor -->
        <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.ShowEditor, Mode=OneWay}">
            <StackPanel Padding="24,12,24,24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <!-- Preset badge -->
                        <Border
                            Width="56"
                            Height="56"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.PresetLabel, Mode=OneWay}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.PresetBankText, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.PresetName, Mode=OneWay}" />
                                <Border
                                    Padding="8,2,8,3"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind ViewModel.IsModified, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE70F;" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Unsaved changes" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <CommandBar
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        OverflowButtonVisibility="Collapsed">
                        <AppBarButton
                            Click="OnSaveClick"
                            Icon="Save"
                            IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                            Label="Save" />
                        <AppBarButton
                            Click="OnImportClick"
                            IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                            Label="Import">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8B5;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Click="OnExportClick"
                            IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                            Label="Export">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xEDE1;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <!-- Preset-level fields -->
                <Grid Margin="0,16,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="16,10" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE767;" />
                                <TextBlock Text="Preset volume" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.PresetVolume, Mode=OneWay}" />
                            <Slider
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                IsThumbToolTipEnabled="False"
                                Maximum="100"
                                Minimum="0"
                                Value="{x:Bind ViewModel.PresetVolume, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="16,10"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE916;" />
                                <StackPanel>
                                    <TextBlock Text="Tempo" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="BPM for tempo-synced effects" />
                                </StackPanel>
                            </StackPanel>
                            <NumberBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                Maximum="{x:Bind ViewModel.BpmMaximum}"
                                Minimum="{x:Bind ViewModel.BpmMinimum}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.PresetBpm, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Signal chain -->
                <StackPanel Margin="0,24,0,8" Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE71B;" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Signal chain" />
                </StackPanel>
                <ListView
                    x:Name="ChainList"
                    Margin="-4,0"
                    Padding="0,0,0,8"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="OnChainDragCompleted"
                    DragItemsStarting="OnChainDragStarting"
                    ItemTemplate="{StaticResource ChainGroupTemplate}"
                    ItemsSource="{x:Bind ViewModel.Chain}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Drag NR, FX1, FX2, DLY or RVB to reorder. Click a module to edit it." />

                <!-- Module editor -->
                <StackPanel Margin="0,24,0,8" Orientation="Horizontal" Spacing="10">
                    <Border
                        Width="32"
                        Height="32"
                        Background="{x:Bind local:ModuleVisuals.Tint(ViewModel.Editor.ModuleName), Mode=OneWay}"
                        CornerRadius="16">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind local:ModuleVisuals.Brush(ViewModel.Editor.ModuleName), Mode=OneWay}"
                            Glyph="{x:Bind local:ModuleVisuals.Glyph(ViewModel.Editor.ModuleName), Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Editor.Title, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No effect could be decoded for this module."
                    Visibility="{x:Bind local:PresetsView.Not(ViewModel.Editor.HasEffect), Mode=OneWay}" />
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Editor.HasEffect, Mode=OneWay}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <ComboBox
                                    MinWidth="220"
                                    Header="Effect"
                                    IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.Editor.EffectNames, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.Editor.SelectedEffectIndex, Mode=TwoWay}" />
                                <ToggleSwitch
                                    MinWidth="0"
                                    Header="Enabled"
                                    IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.Editor.IsOn, Mode=TwoWay}" />
                                <ComboBox
                                    MinWidth="120"
                                    Header="Footswitch"
                                    IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.Editor.FootswitchIndex, Mode=TwoWay}">
                                    <x:String>None</x:String>
                                    <x:String>FS1</x:String>
                                    <x:String>FS2</x:String>
                                </ComboBox>
                                <ToggleSwitch
                                    MinWidth="0"
                                    Header="Clone mode"
                                    IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.Editor.IsCloneMode, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.Editor.IsAmp, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Editor.Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.Editor.HasDescription, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- User IR / User Profile slot the effect plays from -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Editor.HasSlot, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                Background="{x:Bind local:ModuleVisuals.Tint(ViewModel.Editor.ModuleName), Mode=OneWay}"
                                CornerRadius="18">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{x:Bind local:ModuleVisuals.Brush(ViewModel.Editor.ModuleName), Mode=OneWay}"
                                    Glyph="&#xE8B7;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Editor.SlotTitle, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Editor.SlotHint, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Click="OnSlotLoadClick" IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                        <TextBlock Text="Load file…" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnSlotRenameClick" IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                                        <TextBlock Text="Rename…" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnSlotClearClick" IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock Text="Clear" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Delay tap tempo -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Editor.HasTapTempo, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Width="120" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE916;" />
                                    <TextBlock Text="Tap tempo" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Sets the delay time"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                MinWidth="96"
                                VerticalAlignment="Bottom"
                                Click="OnTapClick"
                                IsEnabled="{x:Bind ViewModel.Editor.IsIdle, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                        Opacity="{x:Bind local:PresetsView.BeatOpacity(ViewModel.Editor.TapTempo.IsBeat), Mode=OneWay}" />
                                    <TextBlock Text="Tap" />
                                </StackPanel>
                            </Button>
                            <NumberBox
                                Width="120"
                                Header="BPM"
                                Maximum="300"
                                Minimum="20"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.Editor.TapTempo.Bpm, Mode=TwoWay}" />
                            <ComboBox
                                MinWidth="96"
                                Header="Division"
                                ItemsSource="{x:Bind ViewModel.Editor.TapTempo.Divisions, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.Editor.TapTempo.DivisionIndex, Mode=TwoWay}" />
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Delay time" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Editor.TapTempo.ResultText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Longer than the delay allows — clamped"
                                Visibility="{x:Bind ViewModel.Editor.TapTempo.IsOutOfRange, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater ItemTemplate="{StaticResource ParameterTemplateSelector}" ItemsSource="{x:Bind ViewModel.Editor.Parameters}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemHeight="84"
                                MinItemWidth="240"
                                MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
