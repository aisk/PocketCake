<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PocketCake.Views.SlotsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PocketCake.Views"
    xmlns:vm="using:PocketCake.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="SlotTemplate" x:DataType="vm:SlotItem">
            <Border Margin="0,0,0,4" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        Background="{x:Bind local:ModuleVisuals.Tint(Module)}"
                        CornerRadius="18">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind local:ModuleVisuals.Brush(Module)}"
                            Glyph="{x:Bind local:ModuleVisuals.Glyph(Module)}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Title}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnLoadClick" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                <TextBlock Text="Load file…" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRenameClick" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                                <TextBlock Text="Rename…" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnClearClick" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="1000" Padding="24,12,24,24">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="IR &amp; NAM slots" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The pedal stores five user impulse responses and five user amp profiles. Presets pick them as the User IR and User Profile effects."
                    TextWrapping="Wrap" />
                <InfoBar
                    Margin="0,12,0,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowDisconnected, Mode=OneWay}"
                    Message="Connect the pedal to read and change its slots."
                    Severity="Informational" />

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="User IRs (.wav)" />
                <ItemsControl ItemTemplate="{StaticResource SlotTemplate}" ItemsSource="{x:Bind ViewModel.IrSlots}" />

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="User Profiles (.nam → clone)" />
                <InfoBar
                    Margin="0,0,0,8"
                    IsClosable="False"
                    IsOpen="True"
                    Message="The pedal can't run NAM models. Each .nam is measured on this PC and fitted to the pedal's simpler clone model (filter → saturator → filter), so EQ, cabinet and overall distortion carry over, but multi-stage gain and dynamics such as sag or compression don't."
                    Severity="Informational"
                    Title="Converted, not copied">
                    <InfoBar.ActionButton>
                        <HyperlinkButton Content="How the conversion works" NavigateUri="https://github.com/aisk/PocketCake#nam-conversion" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <ItemsControl ItemTemplate="{StaticResource SlotTemplate}" ItemsSource="{x:Bind ViewModel.CloneSlots}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Slot names are limited to 10 characters for IRs and 15 for profiles."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
