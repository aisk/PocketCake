<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PocketCake.Views.SlotsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PocketCake.Views"
    xmlns:vm="using:PocketCake.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="SlotTemplate" x:DataType="vm:SlotItem">
            <Border Margin="0,0,0,4" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        Background="{x:Bind local:ModuleVisuals.Tint(Module)}"
                        CornerRadius="18">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind local:ModuleVisuals.Brush(Module)}"
                            Glyph="{x:Bind local:ModuleVisuals.Glyph(Module)}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Title}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnLoadClick" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                <TextBlock Text="Load file…" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRenameClick" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                                <TextBlock Text="Rename…" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnClearClick" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="1000" Padding="24,12,24,24">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="IR &amp; NAM slots" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The pedal stores five user impulse responses and five user amp profiles. Presets pick them as the User IR and User Profile effects."
                    TextWrapping="Wrap" />
                <InfoBar
                    Margin="0,12,0,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowDisconnected, Mode=OneWay}"
                    Message="Connect the pedal to read and change its slots."
                    Severity="Informational" />

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="User IRs (.wav)" />
                <ItemsControl ItemTemplate="{StaticResource SlotTemplate}" ItemsSource="{x:Bind ViewModel.IrSlots}" />

                <StackPanel Margin="0,24,0,8" Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="User Profiles (.nam → clone)" />
                    <Button
                        Padding="4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="How NAM models play on the pedal"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="How NAM models play on the pedal">
                        <FontIcon FontSize="14" Glyph="&#xE946;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel MaxWidth="400" Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="How NAM models play on the pedal" />
                                    <TextBlock TextWrapping="Wrap">
                                        The pedal has no neural-network engine. Its User Profiles use a simpler clone model:
                                        a filter, one saturator and a second filter.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        When you load a .nam, PocketCake plays a reference guitar signal through the NAM model
                                        at several levels on this PC and fits the clone model to the result. It takes a few
                                        seconds, and the same file always gives the same profile.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold">Carries over:</Run>
                                        overall EQ, cabinet colour and the distortion curve.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold">Beyond what the pedal can play back:</Run>
                                        several interacting gain stages and dynamics such as sag or compression, so very
                                        high-gain captures lose detail and touch response feels flatter.
                                    </TextBlock>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Supports NAM WaveNet models (v0.5 – v0.7, including Tone3000 SlimmableContainer)."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <ItemsControl ItemTemplate="{StaticResource SlotTemplate}" ItemsSource="{x:Bind ViewModel.CloneSlots}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Slot names are limited to 10 characters for IRs and 15 for profiles."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
