<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PocketCake.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PocketCake.Views">

    <Page.Resources>
        <Style x:Key="RowSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
        </Style>
        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="48" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="1000" Padding="24,12,24,24">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
                <InfoBar
                    Margin="0,12,0,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowPlaceholder, Mode=OneWay}"
                    Message="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                    Severity="Informational" />

                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Levels" />
                        <local:SettingsRow Description="Device-wide output level, independent of the preset volume" Glyph="&#xE767;" Header="Master volume">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider
                                    Maximum="100"
                                    Minimum="0"
                                    Style="{StaticResource RowSliderStyle}"
                                    Value="{x:Bind ViewModel.MasterVolume, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource RowValueStyle}" Text="{x:Bind ViewModel.MasterVolume, Mode=OneWay}" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE720;" Header="Input level">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider
                                    Maximum="20"
                                    Minimum="-20"
                                    Style="{StaticResource RowSliderStyle}"
                                    Value="{x:Bind ViewModel.InputLevel, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource RowValueStyle}" Text="{x:Bind local:SettingsView.Db(ViewModel.InputLevel), Mode=OneWay}" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE93C;" Header="FX record level">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider
                                    Maximum="20"
                                    Minimum="-20"
                                    Style="{StaticResource RowSliderStyle}"
                                    Value="{x:Bind ViewModel.FxRecLevel, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource RowValueStyle}" Text="{x:Bind local:SettingsView.Db(ViewModel.FxRecLevel), Mode=OneWay}" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE702;" Header="BT record level">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider
                                    Maximum="20"
                                    Minimum="-20"
                                    Style="{StaticResource RowSliderStyle}"
                                    Value="{x:Bind ViewModel.BtRecLevel, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource RowValueStyle}" Text="{x:Bind local:SettingsView.Db(ViewModel.BtRecLevel), Mode=OneWay}" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE7F6;" Header="Monitor level">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider
                                    Maximum="20"
                                    Minimum="-20"
                                    Style="{StaticResource RowSliderStyle}"
                                    Value="{x:Bind ViewModel.MonitorLevel, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource RowValueStyle}" Text="{x:Bind local:SettingsView.Db(ViewModel.MonitorLevel), Mode=OneWay}" />
                            </StackPanel>
                        </local:SettingsRow>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="USB audio" />
                        <local:SettingsRow Description="Dry or wet signal on the USB audio output" Glyph="&#xECF0;" Header="Mode">
                            <ComboBox MinWidth="160" SelectedIndex="{x:Bind ViewModel.UsbMode, Mode=TwoWay}">
                                <x:String>Dry</x:String>
                                <x:String>Wet</x:String>
                            </ComboBox>
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE9F3;" Header="Re-amp">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Reamp, Mode=TwoWay}" />
                        </local:SettingsRow>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="EXP / FS jack" />
                        <local:SettingsRow Description="What is plugged into the expression jack" Glyph="&#xEA86;" Header="Type">
                            <ComboBox MinWidth="160" SelectedIndex="{x:Bind ViewModel.ExpFsType, Mode=TwoWay}">
                                <x:String>Expression pedal</x:String>
                                <x:String>Single footswitch</x:String>
                                <x:String>Dual footswitch</x:String>
                            </ComboBox>
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE8EC;" Header="{x:Bind ViewModel.Target1Header, Mode=OneWay}">
                            <ComboBox
                                MinWidth="160"
                                ItemsSource="{x:Bind ViewModel.TargetOptions, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.Target1, Mode=TwoWay}" />
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE8EC;" Header="Function 2" Visibility="{x:Bind ViewModel.HasTarget2, Mode=OneWay}">
                            <ComboBox
                                MinWidth="160"
                                ItemsSource="{x:Bind ViewModel.TargetOptions, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.Target2, Mode=TwoWay}" />
                        </local:SettingsRow>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Display &amp; power" />
                        <local:SettingsRow Glyph="&#xE706;" Header="Backlight">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider
                                    Maximum="10"
                                    Minimum="0"
                                    Style="{StaticResource RowSliderStyle}"
                                    Value="{x:Bind ViewModel.Backlight, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource RowValueStyle}" Text="{x:Bind ViewModel.Backlight, Mode=OneWay}" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE8BE;" Header="ECO mode">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Eco, Mode=TwoWay}" />
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE7E8;" Header="Power-off confirmation">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.PowerConfirm, Mode=TwoWay}" />
                        </local:SettingsRow>
                        <local:SettingsRow Glyph="&#xE83F;" Header="Battery only">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.BattOnly, Mode=TwoWay}" />
                        </local:SettingsRow>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Reset" />
                        <local:SettingsRow Description="Restores every preset and setting. The pedal reboots and disconnects." Glyph="&#xE777;" Header="Factory reset">
                            <Button Click="OnFactoryResetClick" Content="Reset…" />
                        </local:SettingsRow>
                    </StackPanel>
                </ContentControl>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="App" />
                <local:SettingsRow Description="{x:Bind ViewModel.DetectedModelText, Mode=OneWay}" Glyph="&#xE703;" Header="Device model">
                    <ComboBox MinWidth="160" SelectedIndex="{x:Bind ViewModel.ModelIndex, Mode=TwoWay}">
                        <x:String>Auto-detect</x:String>
                        <x:String>Pocket Master</x:String>
                        <x:String>Smart Box</x:String>
                    </ComboBox>
                </local:SettingsRow>
                <local:SettingsRow Description="{x:Bind ViewModel.AgentDescription, Mode=OneWay}" Glyph="&#xE99A;" Header="Agent control (MCP)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnCopyAgentCommandClick"
                            Content="Copy setup command"
                            ToolTipService.ToolTip="{x:Bind ViewModel.AgentCommand}"
                            Visibility="{x:Bind ViewModel.AgentControl, Mode=OneWay}" />
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AgentControl, Mode=TwoWay}" />
                    </StackPanel>
                </local:SettingsRow>
                <local:SettingsRow Description="Native editor for Sonicake Pocket Master and Smart Box" Glyph="&#xE946;" Header="About">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Version}" />
                </local:SettingsRow>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
